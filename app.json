{
  "expo": {
    "name": "Pacewell",
    "slug": "pacewell",
    "scheme": "pacewell",
    "version": "0.12.13",
    "orientation": "portrait",
    "icon": "./assets/branding/pacewell-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gonsalves.pacewell",
      "buildNumber": "19",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Pacewell reads your health data to provide personalised recovery insights."
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#2E7D52",
        "foregroundImage": "./assets/branding/pacewell-logo-white-transparent.png"
      },
      "package": "com.gonsalves.pacewell",
      "versionCode": 19,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-image-picker",
      "@react-native-community/datetimepicker",
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "@kingstinct/react-native-healthkit",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/pacewell-logo-white-transparent.png",
          "color": "#2E7D52"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/pacewell-logo-white-transparent.png",
          "resizeMode": "contain",
          "backgroundColor": "#2E7D52"
        }
      ],
      "expo-background-task",
      "expo-task-manager"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2bbc1df-3134-41c4-9ad0-b17b03c4183a"
      }
    }
  }
}
